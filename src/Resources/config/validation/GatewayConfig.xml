<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">
    <!-- sylius_quickpay is the group Sylius validates a Quickpay payment method's gateway config in, in the admin form
         and the Admin API (the plugin's extension prepends it to sylius_payum.gateway_config.validation_groups) -->
    <class name="Sylius\Bundle\PayumBundle\Model\GatewayConfig">
        <constraint name="Setono\SyliusQuickpayPlugin\Validator\Constraints\UsableGatewayConfiguration">
            <option name="groups">sylius_quickpay</option>
        </constraint>
    </class>
</constraint-mapping>
