<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <!-- Controllers -->
        <service id="Setono\SyliusQuickpayPlugin\Controller\NotifyAction" public="true">
            <argument type="service" id="payum"/>
            <argument type="service" id="sylius.repository.order"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Provider\PaymentProvider"/>
            <argument type="service" id="sylius.repository.gateway_config"/>
        </service>

        <!-- Provider -->
        <service id="Setono\SyliusQuickpayPlugin\Provider\PaymentProvider"/>

        <service id="Setono\SyliusQuickpayPlugin\Provider\PaymentProviderInterface"
                 alias="Setono\SyliusQuickpayPlugin\Provider\PaymentProvider"/>

        <service id="Setono\SyliusQuickpayPlugin\Provider\PendingPaymentProvider">
            <argument type="service" id="doctrine"/>
            <argument>%sylius.model.payment.class%</argument>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Provider\PendingPaymentProviderInterface"
                 alias="Setono\SyliusQuickpayPlugin\Provider\PendingPaymentProvider"/>

        <service id="Setono\SyliusQuickpayPlugin\Controller\Admin\PaymentOperationsAction" public="true">
            <argument type="service" id="sylius.repository.payment"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactoryInterface"/>
            <argument type="service" id="twig"/>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Controller\Admin\SendPaymentLinkAction" public="true">
            <argument type="service" id="sylius.repository.payment"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\PaymentLink\PaymentLinkProviderInterface"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Mailer\PaymentLinkEmailManagerInterface"/>
            <argument type="service" id="security.csrf.token_manager"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="router"/>
        </service>

        <!-- Mailer -->
        <service id="Setono\SyliusQuickpayPlugin\Mailer\PaymentLinkEmailManager">
            <argument type="service" id="sylius.email_sender"/>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Mailer\PaymentLinkEmailManagerInterface"
                 alias="Setono\SyliusQuickpayPlugin\Mailer\PaymentLinkEmailManager"/>

        <!-- Payment link -->
        <service id="Setono\SyliusQuickpayPlugin\PaymentLink\PaymentLinkProvider">
            <argument type="service" id="router"/>
            <argument type="service" id="url_helper"/>
            <argument>%sylius.unsecured_urls%</argument>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\PaymentLink\PaymentLinkProviderInterface"
                 alias="Setono\SyliusQuickpayPlugin\PaymentLink\PaymentLinkProvider"/>

        <!-- Twig -->
        <service id="Setono\SyliusQuickpayPlugin\Twig\PaymentExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Twig\PaymentRuntime">
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Checkout\PaymentMethodLogoProviderInterface"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\PaymentLink\PaymentLinkProviderInterface"/>

            <tag name="twig.runtime"/>
        </service>

        <!-- Quickpay client -->
        <service id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactory"/>

        <service id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactoryInterface"
                 alias="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactory"/>

        <!-- Validator -->
        <service id="Setono\SyliusQuickpayPlugin\Validator\Constraints\QuickpayCredentialsValidator">
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactoryInterface"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <!-- Command -->
        <service id="Setono\SyliusQuickpayPlugin\Command\ReconcilePaymentsCommand">
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Provider\PendingPaymentProviderInterface"/>
            <argument type="service" id="payum"/>
            <argument type="service" id="sylius_abstraction.state_machine"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactoryInterface"/>
            <argument type="service" id="sylius.repository.gateway_config"/>
            <argument type="service" id="doctrine"/>

            <tag name="console.command"/>
        </service>

        <!-- Action -->
        <service id="Setono\SyliusQuickpayPlugin\Action\ConvertPaymentAction" public="true">
            <argument type="service" id="payum"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Taxation\VatRateResolver"/>

            <tag name="payum.action"
                 factory="quickpay"
                 alias="setono_sylius_quickpay.quickpay.convert_payment"/>
        </service>

        <!-- Payum extension -->
        <service id="Setono\SyliusQuickpayPlugin\Payum\Extension\NotifyIdempotencyExtension" public="true">
            <!-- the factory of the setono_sylius_quickpay lock resource the extension prepends onto framework.lock -->
            <argument type="service" id="lock.setono_sylius_quickpay.factory"/>

            <call method="setLogger">
                <argument type="service" id="logger" on-invalid="ignore"/>
            </call>

            <tag name="payum.extension"
                 factory="quickpay"
                 alias="setono_sylius_quickpay.notify_idempotency"/>
        </service>

        <!-- Fraud -->
        <service id="Setono\SyliusQuickpayPlugin\Fraud\FraudChecker">
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Quickpay\ClientFactoryInterface"/>

            <call method="setLogger">
                <argument type="service" id="logger" on-invalid="ignore"/>
            </call>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Fraud\FraudCheckerInterface"
                 alias="Setono\SyliusQuickpayPlugin\Fraud\FraudChecker"/>

        <!-- State machine -->
        <service id="Setono\SyliusQuickpayPlugin\StateMachine\PaymentProcessor" public="true">
            <argument type="service" id="payum"/>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Fraud\FraudCheckerInterface"/>
            <argument>%setono_sylius_quickpay.operations.capture%</argument>
            <argument>%setono_sylius_quickpay.operations.refund%</argument>
            <argument>%setono_sylius_quickpay.operations.cancel%</argument>
            <argument>%setono_sylius_quickpay.fraud.block_capture%</argument>

            <call method="setLogger">
                <argument type="service" id="logger" on-invalid="ignore"/>
            </call>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\StateMachine\PaymentProcessorInterface"
                 alias="Setono\SyliusQuickpayPlugin\StateMachine\PaymentProcessor"/>

        <service id="Setono\SyliusQuickpayPlugin\StateMachine\WorkflowSubscriber">
            <argument type="service" id="Setono\SyliusQuickpayPlugin\StateMachine\PaymentProcessorInterface"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Form -->
        <service id="Setono\SyliusQuickpayPlugin\Form\Type\GatewayConfigurationType">
            <tag name="sylius.gateway_configuration_type"
                 type="quickpay"
                 label="setono_sylius_quickpay.payum_gateway_factory.quickpay"/>
        </service>

        <!-- Factory builder -->
        <service id="Setono\SyliusQuickpayPlugin\FactoryBuilder\QuickpayGatewayFactoryBuilder">
            <argument>Setono\Payum\Quickpay\QuickpayGatewayFactory</argument>
            <argument type="service" id="Setono\SyliusQuickpayPlugin\Guesser\LanguageGuesser"/>

            <tag name="payum.gateway_factory_builder"
                 factory="quickpay"/>
        </service>

        <!-- Taxation -->
        <service id="Setono\SyliusQuickpayPlugin\Taxation\VatRateResolver"/>

        <service id="Setono\SyliusQuickpayPlugin\Taxation\VatRateResolverInterface"
                 alias="Setono\SyliusQuickpayPlugin\Taxation\VatRateResolver"/>

        <!-- Checkout presentation -->
        <service id="Setono\SyliusQuickpayPlugin\Checkout\PaymentMethodLogoProvider">
            <argument>%setono_sylius_quickpay.checkout.payment_method_logos%</argument>
            <argument>%setono_sylius_quickpay.checkout.creditcard_brands%</argument>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Checkout\PaymentMethodLogoProviderInterface"
                 alias="Setono\SyliusQuickpayPlugin\Checkout\PaymentMethodLogoProvider"/>


        <!-- Guesser -->
        <service id="Setono\SyliusQuickpayPlugin\Guesser\LanguageGuesser">
            <argument type="service" id="sylius.context.locale"/>
        </service>

        <service id="Setono\SyliusQuickpayPlugin\Guesser\LanguageGuesserInterface"
                 alias="Setono\SyliusQuickpayPlugin\Guesser\LanguageGuesser"/>

    </services>
</container>
